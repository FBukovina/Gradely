// Copy to Config/Secrets.xcconfig locally and fill with real values.
// The empty $() keeps // from being parsed as an xcconfig comment.
REVENUECAT_IOS_API_KEY = revenuecat_ios_sdk_key_here
REVENUECAT_MACOS_API_KEY = revenuecat_macos_sdk_key_here
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_or_publishable_key
