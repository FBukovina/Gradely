    "siri.discovery.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povol Siri a Spotlightu vyhledávat na tomto zařízení názvy předmětů, známky, časy a učebny hodin a přehledy nedokončených položek Plánovače. Přihlašovací údaje, soukromé poznámky a AI chaty se nezpřístupňují. Vypnutí odstraní vyhledávací index; přímé příkazy Siri zůstanou dostupné."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "povol siri a spotlightu vyhledávat na tomto zařízení názvy předmětů, známky, časy a učebny hodin a přehledy nedokončených položek plánovače. přihlašovací údaje, soukromé poznámky a AI chaty se nezpřístupňují. vypnutí odstraní vyhledávací index; přímé příkazy siri zůstanou dostupné."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Siri and Spotlight to find subject names, grades, lesson times and rooms, and incomplete Planner summaries on this device. Credentials, private notes, and AI chats are excluded. Turning this off removes the search index; direct Siri commands remain available."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "allow siri and spotlight to find subject names, grades, lesson times and rooms, and incomplete planner summaries on this device. credentials, private notes, and AI chats are excluded. turning this off removes the search index; direct siri commands remain available."
          }
        }
      }
    },
