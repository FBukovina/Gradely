    "age.gate.blocked.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvůli COPPA Gradey nenabízí účet ani školní synchronizaci dětem mladším 13 let. Pokud jsi to klepl omylem, věk můžeš vybrat znovu."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvůli COPPA Gradey nenabízí účet ani školní synchronizaci dětem mladším 13 let. Pokud jsi to klepl omylem, věk můžeš vybrat znovu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because of COPPA, Gradey doesn’t offer accounts or school sync to children under 13. If you tapped this by mistake, you can choose a different age."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "because of COPPA, Gradey doesn’t offer accounts or school sync to children under 13. If you tapped this by mistake, you can choose a different age."
          }
        }
      }
    },
