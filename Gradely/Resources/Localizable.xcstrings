      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecný chat odesílá tvoje zprávy a související historii chatu. Školní údaje se automaticky nepřikládají. Ostatní akce sdílí předměty, hodiny, události a přehledy uvedené ve výběru. Poznámky k testu se sdílí jen po zapnutí volby „Zahrnout poznámky k tomuto testu“."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "obecný chat odesílá tvoje zprávy a související historii chatu. školní údaje se automaticky nepřikládají. ostatní akce sdílí předměty, hodiny, události a přehledy uvedené ve výběru. poznámky k testu se sdílí jen po zapnutí volby „zahrnout poznámky k tomuto testu“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General chat sends your messages and relevant chat history, without automatically attaching school data. Other actions share the subjects, lessons, events and summaries shown in your selection. Test notes are shared only if you turn on “Include notes for this test”."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
