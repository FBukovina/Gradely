    "privacy.update.change.cleanup.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starší verze Gradey hesla do Bakalářů nahrávaly. Tato pole jsme odstranili z aktivní serverové databáze a ověřili, že v jejích šifrovaných záznamech žádná nezůstala. Zápisy nyní pole s hesly před uložením odstraňují. Smazání z aktivní databáze neodstraňuje okamžitě kopie v historických zálohách a protokolech, na které se vztahují jejich podmínky uchování."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "starší verze Gradey hesla do bakalářů nahrávaly. tato pole jsme odstranili z aktivní serverové databáze a ověřili, že v jejích šifrovaných záznamech žádná nezůstala. zápisy nyní pole s hesly před uložením odstraňují. smazání z aktivní databáze neodstraňuje okamžitě kopie v historických zálohách a protokolech, na které se vztahují jejich podmínky uchování."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earlier versions of Gradey did upload Bakaláři passwords. We removed those fields from the active backend database and verified that none remained in its encrypted records. Writes now strip password fields before storage. Deleting from an active database does not immediately remove historical backup and log copies, which stay subject to their retention arrangements."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "earlier versions of Gradey did upload Bakaláři passwords. we removed those fields from the active backend database and verified that none remained in its encrypted records. writes now strip password fields before storage. deleting from an active database does not immediately remove historical backup and log copies, which stay subject to their retention arrangements."
          }
        }
      }
    },
    "privacy.update.change.cleanup.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pole s hesly jsme 8. září 2026 odstranili z aktivní databáze."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pole s hesly jsme 8. září 2026 odstranili z aktivní databáze."
          }
