    "privacy.update.change.ai.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Firebase a Microsoft Azure OpenAI zpracovávají tvoje zprávy, související historii chatu a vybrané školní údaje pro vytváření odpovědí. Obecný chat školní údaje automaticky nepřikládá. Poznámky z Plánovače se zahrnou jen tehdy, když je zapneš pro vybraný test. Uložené chaty můžeš smazat nebo v nastavení odvolat souhlas s AI. Odpovědi můžou být chybné; důležité informace si ověř."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Firebase a Microsoft Azure OpenAI zpracovávají tvoje zprávy, související historii chatu a vybrané školní údaje pro vytváření odpovědí. obecný chat školní údaje automaticky nepřikládá. poznámky z plánovače se zahrnou jen tehdy, když je zapneš pro vybraný test. uložené chaty můžeš smazat nebo v nastavení odvolat souhlas s AI. odpovědi můžou být chybné; důležité informace si ověř."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Firebase and Microsoft Azure OpenAI process your messages, relevant chat history and selected school information to generate replies. General chat does not automatically attach school data. Planner notes are included only when you enable them for a selected test. You can delete saved chats or withdraw AI consent in settings. Replies can be wrong; verify important information."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Firebase and Microsoft Azure OpenAI process your messages, relevant chat history and selected school information to generate replies. general chat does not automatically attach school data. planner notes are included only when you enable them for a selected test. you can delete saved chats or withdraw AI consent in settings. replies can be wrong; verify important information."
          }
        }
      }
    },
    "privacy.update.change.ai.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey AI je volitelná a vyžaduje samostatný souhlas. Sám vybíráš, které školní údaje chceš sdílet."
