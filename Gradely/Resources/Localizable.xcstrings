    "onboarding.account.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělej si soukromé Gradey ID přes Apple, synchronizujte nastavení mezi zařízeními a zapni oznámení. Nemusíš si pamatovat žádné další heslo."
