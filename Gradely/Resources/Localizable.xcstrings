    "gradey.ai.consent.azure.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje dotazy, nedávná historie chatu a omezený školní kontext se bezpečně odesílají přes Firebase Functions do Microsoft Azure AI. Tvoje přihlašovací údaje ke škole ani původní odpovědi školního systému se nikdy neodesílají."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvoje dotazy, nedávná historie chatu a omezený školní kontext se bezpečně odesílají přes Firebase Functions do Microsoft Azure AI. tvoje přihlašovací údaje ke škole ani původní odpovědi školního systému se nikdy neodesílají."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your prompts, recent chat history, and limited school context are sent securely through Firebase Functions to Microsoft Azure AI. Your school credentials and raw school-provider payloads are never sent."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your prompts, recent chat history, and limited school context are sent securely through Firebase Functions to Microsoft Azure AI. your school credentials and raw school-provider payloads are never sent."
          }
        }
      }
