    "gradey.auth.privacyNote" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Školní hesla zůstávají v Klíčence tohoto zařízení. Hesla do Strava.cz se neukládají. Gradey ID synchronizuje jen očištěné tokeny poskytovatelů a v případě potřeby hesla tě požádá o nové připojení."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "školní hesla zůstávají v klíčence tohoto zařízení. hesla do Strava.cz se neukládají. Gradey ID synchronizuje jen očištěné tokeny poskytovatelů a v případě potřeby hesla tě požádá o nové připojení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "School passwords stay in this device’s Keychain. Strava.cz passwords are not stored. Gradey ID syncs only sanitized provider tokens and asks you to reconnect when a password is needed again."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "school passwords stay in this device’s Keychain. Strava.cz passwords are not stored. Gradey ID syncs only sanitized provider tokens and asks you to reconnect when a password is needed again."
          }
        }
      }
    },
