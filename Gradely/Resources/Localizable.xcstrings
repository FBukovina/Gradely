            "value" : "We deleted the passwords we used to store"
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "we deleted the passwords we used to store"
          }
        }
      }
    },
    "privacy.update.change.password.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje zařízení posílá uživatelské jméno a heslo přímo na HTTPS server školy. Gradey je uchovává v Klíčence vázané na dané zařízení, aby se v případě potřeby mohlo ke škole znovu přihlásit. Heslo není součástí dat, která aktualizovaná aplikace posílá do Gradey."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvoje zařízení posílá uživatelské jméno a heslo přímo na HTTPS server školy. Gradey je uchovává v klíčence vázané na dané zařízení, aby se v případě potřeby mohlo ke škole znovu přihlásit. heslo není součástí dat, která aktualizovaná aplikace posílá do Gradey."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device sends your username and password straight to your school’s HTTPS server to sign in. Gradey keeps them in the device Keychain, tied to that device, so it can sign in to the school again when it needs to. The password is not part of what the updated app sends to Gradey."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your device sends your username and password straight to your school’s HTTPS server to sign in. Gradey keeps them in the device Keychain, tied to that device, so it can sign in to the school again when it needs to. the password is not part of what the updated app sends to Gradey."
          }
        }
      }
    },
