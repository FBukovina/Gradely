    "onboarding.upgrade.support.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Děkujeme, že Gradey používáš. Vývoj i provoz něco stojí; jen cloudové a API služby nás dosud vyšly na více než 700 dolarů. Podpora je dobrovolná: můžeš poslat jednorázový příspěvek nebo zvolit pravidelnou podporu s vyšším denním přídělem Compute a přednostním přístupem k novinkám. Gradey můžeš dál používat bez ohledu na své rozhodnutí."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "děkujeme, že Gradey používáš. vývoj i provoz něco stojí; jen cloudové a API služby nás dosud vyšly na více než 700 dolarů. podpora je dobrovolná: můžeš poslat jednorázový příspěvek nebo zvolit pravidelnou podporu s vyšším denním přídělem Compute a přednostním přístupem k novinkám. Gradey můžeš dál používat bez ohledu na své rozhodnutí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for using Gradey. Development and running costs add up; cloud and API services alone have already cost more than $700. Support is optional: leave a one-time tip or choose recurring support for a higher daily Compute allowance and early access to new features. You can keep using Gradey either way."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "thank you for using Gradey. development and running costs add up; cloud and API services alone have already cost more than $700. support is optional: leave a one-time tip or choose recurring support for a higher daily Compute allowance and early access to new features. you can keep using Gradey either way."
          }
        }
      }
    },
