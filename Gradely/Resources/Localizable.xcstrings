    "absence.override.subjectMappingUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Škola neposkytuje jednoznačný součet pro předměty: %@. Tyto hodiny ponechte viditelné, nebo opravte předmět, pokud byl přiřazen nesprávně."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Škola neposkytuje jednoznačný součet pro předměty: %@. Tyto hodiny ponechte viditelné, nebo opravte předmět, pokud byl přiřazen nesprávně."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The school has no unique subject total for: %@. Keep these lessons visible, or correct their subject if it was assigned incorrectly."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The school has no unique subject total for: %@. Keep these lessons visible, or correct their subject if it was assigned incorrectly."
          }
        }
      }
    },
