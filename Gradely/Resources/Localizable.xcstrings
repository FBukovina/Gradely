    "onboarding.upgrade.account.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte si Gradey ID přes Apple, synchronizujte nastavení mezi zařízeními a zapněte upozornění na nové známky. Můžete také pokračovat a Gradey ID si vytvořit později v Nastavení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a Gradey ID with Apple to sync settings across devices and enable new-mark notifications. You can also continue now and create it later in Settings."
          }
        }
      }
    },
    "onboarding.upgrade.account.continueWithout" : {
