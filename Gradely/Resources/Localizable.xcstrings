    "onboarding.upgrade.account.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoř si Gradey ID přes Apple, synchronizuj nastavení mezi zařízeními a zapni upozornění na nové známky. Můžeš také pokračovat a Gradey ID si vytvořit později v Nastavení."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "vytvoř si Gradey ID přes Apple, synchronizuj nastavení mezi zařízeními a zapni upozornění na nové známky. můžeš také pokračovat a Gradey ID si vytvořit později v nastavení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a Gradey ID with Apple to sync settings across devices and enable new-mark notifications. You can also continue now and create it later in Settings."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "create a Gradey ID with apple to sync settings across devices and enable new-mark notifications. you can also continue now and create it later in settings."
          }
        }
      }
    },
