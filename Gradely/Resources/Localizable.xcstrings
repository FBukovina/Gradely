    "planner.calendar.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do kalendáře Gradey se posílají jen položky se zapnutou synchronizací. Přístup ke kalendáři umožňuje Gradey upravovat a mazat vlastní události. Změny provedené v Kalendáři se do Plánovače nepřebírají."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do kalendáře Gradey se posílají jen položky se zapnutou synchronizací. Přístup ke kalendáři umožňuje Gradey upravovat a mazat vlastní události. Změny provedené v Kalendáři se do Plánovače nepřebírají."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with Calendar sync enabled are sent to the Gradey calendar. Calendar access lets Gradey update and remove its events. Changes made in Calendar are not imported."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with Calendar sync enabled are sent to the Gradey calendar. Calendar access lets Gradey update and remove its events. Changes made in Calendar are not imported."
          }
        }
      }
    },
    "planner.calendar.needsDate" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro synchronizaci s Kalendářem vyber den nebo termín. Položky bez času se uloží jako celodenní události."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro synchronizaci s Kalendářem vyber den nebo termín. Položky bez času se uloží jako celodenní události."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a day or due date to enable Calendar sync. Items without a time become all-day events."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a day or due date to enable Calendar sync. Items without a time become all-day events."
          }
        }
      }
    },
