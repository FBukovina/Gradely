    "onboarding.upgrade.support.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Děkujeme, že Gradey používáte. Vývoj i provoz něco stojí; jen cloudové a API služby nás dosud vyšly na více než 700 dolarů. Podpora je dobrovolná — jednorázovým příspěvkem, nebo pravidelnou podporou, která zvedne denní limit Gradey AI a otevře přednostní přístup k novinkám. Gradey můžeš dál používat bez ohledu na své rozhodnutí."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "děkujeme, že Gradey používáte. vývoj i provoz něco stojí; jen cloudové a API služby nás dosud vyšly na více než 700 dolarů. podpora je dobrovolná — jednorázovým příspěvkem, nebo pravidelnou podporou, která zvedne denní limit Gradey AI a otevře přednostní přístup k novinkám. Gradey můžeš dál používat bez ohledu na své rozhodnutí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for using Gradey. Building and running it has real costs; cloud and API services alone have already cost more than $700. Supporting us is optional — with a one-time tip, or with recurring support that raises the Gradey AI daily limit and unlocks early access. You can keep using Gradey either way."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "thank you for using Gradey. building and running it has real costs; cloud and API services alone have already cost more than $700. supporting us is optional — with a one-time tip, or with recurring support that raises the Gradey AI daily limit and unlocks early access. you can keep using Gradey either way."
          }
        }
      }
    },
