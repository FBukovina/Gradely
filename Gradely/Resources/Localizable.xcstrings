    "age.gate.blocked.title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey teď nejde použít"
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gradey teď nejde použít"
          }
