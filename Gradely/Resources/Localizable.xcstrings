            "value" : "gradey isn’t available"
          }
        }
      }
    },
    "age.gate.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey zpracovává školní údaje, volitelné AI a chat podpory. Americké COPPA zakazuje účty pod 13 let. V Česku u uživatelů do 15 let (GDPR) potřebuješ souhlas rodiče nebo zákonného zástupce."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gradey zpracovává školní údaje, volitelné AI a chat podpory. Americké COPPA zakazuje účty pod 13 let. V Česku u uživatelů do 15 let (GDPR) potřebuješ souhlas rodiče nebo zákonného zástupce."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey handles school records, optional AI, and support chat. US law (COPPA) blocks under-13 accounts. In Czechia, digital consent for under-16 users needs a parent or guardian."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gradey handles school records, optional AI, and support chat. US law (COPPA) blocks under-13 accounts. In Czechia, digital consent for under-16 users needs a parent or guardian."
          }
        }
      }
    },
