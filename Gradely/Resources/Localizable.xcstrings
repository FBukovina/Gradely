    "privacy.update.change.tokens.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když propojíš účet Bakalářů s Gradey ID, aplikace získá samostatnou školní relaci. Její přístupový a obnovovací token uchováváme v šifrované podobě na Supabase. Tyto tokeny jsou citlivé údaje: po dobu své platnosti mohou umožňovat přístup ke školním datům. Pokud relaci nelze obnovit, připoj školní účet v Gradey znovu."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "když propojíš účet bakalářů s Gradey ID, aplikace získá samostatnou školní relaci. její přístupový a obnovovací token uchováváme v šifrované podobě na Supabase. tyto tokeny jsou citlivé údaje: po dobu své platnosti mohou umožňovat přístup ke školním datům. pokud relaci nelze obnovit, připoj školní účet v Gradey znovu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you link a Bakaláři account to Gradey ID, the app obtains a separate school session. We store its access and refresh tokens in encrypted form on Supabase. These tokens are sensitive: while they are valid, they can allow access to your school data. If the session can no longer be renewed, reconnect the school account in Gradey."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "when you link a Bakaláři account to Gradey ID, the app obtains a separate school session. we store its access and refresh tokens in encrypted form on Supabase. these tokens are sensitive: while they are valid, they can allow access to your school data. if the session can no longer be renewed, reconnect the school account in Gradey."
          }
        }
      }
    },
    "privacy.update.change.tokens.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrola nových známek obnovuje samostatnou školní relaci místo přihlašování heslem."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kontrola nových známek obnovuje samostatnou školní relaci místo přihlašování heslem."
          }
        },
        "en" : {
