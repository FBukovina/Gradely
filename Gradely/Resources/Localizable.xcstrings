    "gradey.auth.privacyNote" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey nikdy neukládá vaše školní ani jídelní heslo. Připojené účty používají tokeny a při potřebě hesla vás požádají o nové připojení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey never stores your school or canteen password. Linked accounts use provider tokens and ask you to re-link when a password is needed again."
          }
        }
      }
    },
