            "value" : "Dříve uložená hesla jsme smazali"
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dříve uložená hesla jsme smazali"
          }
        },
        "en" : {
          "stringUnit" : {
