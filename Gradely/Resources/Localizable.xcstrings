    "onboarding.upgrade.support.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Děkujeme, že Gradey používáte. Vývoj i provoz něco stojí; jen cloudové a API služby nás dosud vyšly na více než 700 dolarů. Podpora je zcela dobrovolná a Gradey můžete dál používat bez ohledu na své rozhodnutí. Pokud vám aplikace pomáhá, jednorázovým příspěvkem podpoříte její další vývoj."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for using Gradey. Building and running it has real costs; cloud and API services alone have already cost more than $700. Supporting us is completely optional, and you can keep using Gradey either way. If the app helps you, a one-time tip supports its continued development."
          }
        }
      }
    },
    "onboarding.upgrade.support.continue" : {
      "localizations" : {
