    "planner.error.calendarPermission" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plánovač je uložený v tomto zařízení. V nastavení systému povol Gradey plný přístup ke kalendáři a zkus to znovu. Gradey pak může vytvářet, upravovat a mazat své události."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "plánovač je uloženej v tomhle zařízení. v nastavení systému dej Gradey plnej přístup ke kalendáři a zkus to znova, ať může vytvářet, upravovat a mazat svý události."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your planner is saved on this device. Allow Gradey full calendar access in system settings, then try again to create, update, or remove its Calendar events."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your planner is saved on this device. give Gradey full calendar access in system settings, then try again so it can create, update or remove its events."
          }
        }
      }
    },
