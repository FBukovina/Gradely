    "privacy.update.change.watch.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj iPhone může přenést školní data a přihlašovací informace včetně školních přihlašovacích údajů na spárované Apple Watch, aby si data mohly načítat přímo ze školy. Hodinky proto mohou mít vlastní kopii školního hesla a tokenů relace. Chraň přístupové kódy svých zařízení a před předáním zařízení jinému člověku se odhlas nebo zruš párování."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tvůj iPhone může přenést školní data a přihlašovací informace včetně školních přihlašovacích údajů na spárované Apple Watch, aby si data mohly načítat přímo ze školy. hodinky proto mohou mít vlastní kopii školního hesla a tokenů relace. chraň přístupové kódy svých zařízení a před předáním zařízení jinému člověku se odhlas nebo zruš párování."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone can transfer school data and authentication information, including school credentials, to a paired Apple Watch so it can refresh directly from the school. The Watch may therefore keep its own copy of your school password and session tokens. Protect your device passcodes, and sign out or unpair a device before giving it to someone else."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your iphone can transfer school data and authentication information, including school credentials, to a paired apple watch so it can refresh directly from the school. the watch may therefore keep its own copy of your school password and session tokens. protect your device passcodes, and sign out or unpair a device before giving it to someone else."
          }
        }
      }
    },
