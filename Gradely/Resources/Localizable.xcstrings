    "gradey.ai.consent.azure.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše dotazy, nedávná historie chatu a omezený školní kontext se bezpečně odesílají přes Firebase Functions do Microsoft Azure AI. Vaše přihlašovací údaje ke škole ani původní odpovědi školního systému se nikdy neodesílají."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your prompts, recent chat history, and limited school context are sent securely through Firebase Functions to Microsoft Azure AI. Your school credentials and raw school-provider payloads are never sent."
          }
        }
      }
    },
    "gradey.ai.consent.azure.title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpracování službou Azure AI"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processed by Azure AI"
          }
        }
      }
    },
    "gradey.ai.consent.retention.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaty hostů se smažou po 30 dnech neaktivity. Chaty můžete kdykoli smazat nebo odvolat souhlas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guest chats are deleted after 30 days of inactivity. You can delete chats or revoke consent at any time."
          }
        }
      }
    },
    "gradey.ai.consent.retention.title" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data máte pod kontrolou"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay in control"
          }
        }
      }
    },
    "gradey.ai.consent.schoolData.message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey sdílí jen omezený přehled známek a rozvrhu potřebný k odpovědi. Vaše školní heslo nikdy nesdílí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey shares only a limited snapshot of your marks and timetable needed to answer. It never shares your school password."
          }
        }
      }
    },
    "gradey.ai.consent.schoolData.title" : {
      "localizations" : {
