    "age.gate.body" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey zpracovává školní údaje a nabízí volitelné AI funkce a chat podpory. Pokud ti ještě není 16, potřebuješ souhlas rodiče nebo zákonného zástupce (GDPR)."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey zpracovává školní údaje a nabízí volitelné AI funkce a chat podpory. pokud ti ještě není 16, potřebuješ souhlas rodiče nebo zákonného zástupce (GDPR)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradey handles school records, optional AI, and support chat. If you are under 16, a parent or guardian must agree (GDPR)."
          }
        },
        "en-CO" : {
