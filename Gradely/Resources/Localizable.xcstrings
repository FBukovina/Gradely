    "privacy.update.change.planner.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Názvy, poznámky, data a nastavení Plánovače se ukládají v tomto zařízení. Se zapnutým exportem do Kalendáře Gradey spravuje vlastní události, které se můžou synchronizovat přes tvůj kalendářový účet. Při použití AI s vybranými školními údaji se po udělení souhlasu sdílí údaje o zvolených událostech. Poznámky k testu vyžadují samostatné zapnutí. Plánovač funguje i bez těchto voleb."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "názvy, poznámky, data a nastavení plánovače se ukládají v tomto zařízení. se zapnutým exportem do kalendáře Gradey spravuje vlastní události, které se můžou synchronizovat přes tvůj kalendářový účet. při použití AI s vybranými školními údaji se po udělení souhlasu sdílí údaje o zvolených událostech. poznámky k testu vyžadují samostatné zapnutí. plánovač funguje i bez těchto voleb."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Planner titles, notes, dates and preferences are saved on this device. With Calendar export enabled, Gradey manages its own events, which may sync through your calendar account. If you use a contextual AI action, the selected event details are shared with AI after consent. Test notes require a separate choice. Planner works without either option."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "your planner titles, notes, dates and preferences are saved on this device. with calendar export enabled, Gradey manages its own events, which may sync through your calendar account. if you use a contextual AI action, the selected event details are shared with AI after consent. test notes require a separate choice. planner works without either option."
          }
        }
      }
    },
    "privacy.update.change.planner.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Položky Plánovače se ukládají v tomto zařízení. Export do Kalendáře i sdílení vybraných údajů s AI jsou volitelné."
          }
        },
        "cs-US" : {
          "stringUnit" : {
