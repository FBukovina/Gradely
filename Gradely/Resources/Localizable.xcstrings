    "planner.calendar.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do kalendáře Gradey se posílají jen položky se zapnutou synchronizací. Přístup ke kalendáři umožňuje Gradey upravovat a mazat vlastní události. Změny provedené v Kalendáři se do Plánovače nepřebírají."
          }
        },
        "cs-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "do kalendáře Gradey jdou jen věci se zapnutou synchronizací. přístup ke kalendáři nechá Gradey upravovat a mazat jeho vlastní události. změny v kalendáři se zpátky nepřebíraj."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items with Calendar sync enabled are sent to the Gradey calendar. Calendar access lets Gradey update and remove its events. Changes made in Calendar are not imported."
          }
        },
        "en-CO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "only items with calendar sync on go to the Gradey calendar. calendar access lets Gradey update and remove its own events. changes you make in calendar don't come back."
          }
        }
      }
    },
