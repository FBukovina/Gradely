<Application x:Class="Gradely.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Gradely.Windows.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToVisibilityConverter x:Key="InvertNullToVis" Invert="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:GradeBandBrushConverter x:Key="GradeBandBrush" />
            <conv:GradeBandBrushConverter x:Key="GradeBandSoftBrush" Soft="True" />
            <conv:AbsenceRiskBrushConverter x:Key="AbsenceRiskBrush" />
            <conv:LessonChangeBrushConverter x:Key="LessonChangeBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
