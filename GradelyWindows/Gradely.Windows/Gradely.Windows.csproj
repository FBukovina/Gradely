<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gradely.Windows</RootNamespace>
    <AssemblyName>Gradey</AssemblyName>
    <ApplicationIcon>Assets\Gradey.ico</ApplicationIcon>
    <Version>2.8.2</Version>
    <Product>Gradey</Product>
    <Description>Native Windows desktop client for Gradey (Bakaláři, EduPage, Strava.cz)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gradely.Core\Gradely.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Gradey.ico" />
    <Resource Include="..\..\GradelyShared\Fonts\SpaceGrotesk-Regular.ttf" Link="Fonts\SpaceGrotesk-Regular.ttf" />
    <Resource Include="..\..\GradelyShared\Fonts\SpaceGrotesk-Medium.ttf" Link="Fonts\SpaceGrotesk-Medium.ttf" />
    <Resource Include="..\..\GradelyShared\Fonts\SpaceGrotesk-Bold.ttf" Link="Fonts\SpaceGrotesk-Bold.ttf" />
    <Resource Include="..\..\Gradely\Assets.xcassets\GradeyLogo.imageset\GradeyLogo.png" Link="Assets\GradeyLogo.png" />
  </ItemGroup>
</Project>
