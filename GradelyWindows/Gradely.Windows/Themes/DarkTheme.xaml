<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand & Accent Colors (Gradey Dark) -->
    <Color x:Key="BrandPrimaryColor">#1AFFBE</Color>
    <Color x:Key="BrandSecondaryColor">#1FF98C</Color>
    <Color x:Key="BrandOnAccentColor">#041814</Color>

    <!-- Surfaces -->
    <Color x:Key="CanvasBackgroundColor">#0A1011</Color>
    <Color x:Key="SidebarBackgroundColor">#0D1617</Color>
    <Color x:Key="CardBackgroundColor">#131E20</Color>
    <Color x:Key="SettingsBackgroundColor">#020B0C</Color>
    <Color x:Key="TertiaryFillColor">#1CFFFFFF</Color>
    <Color x:Key="HoverFillColor">#141AFFBE</Color>
    <Color x:Key="SelectedFillColor">#221AFFBE</Color>
    <Color x:Key="HairlineColor">#1FFFFFFF</Color>
    <Color x:Key="CardBorderColor">#181AFFBE</Color>

    <!-- Text -->
    <Color x:Key="LabelColor">#FFFFFF</Color>
    <Color x:Key="SecondaryLabelColor">#9AB0B2</Color>
    <Color x:Key="TertiaryLabelColor">#677B7E</Color>

    <!-- Grade Bands & Semantic -->
    <Color x:Key="BandExcellentColor">#1E9F69</Color>
    <Color x:Key="BandGoodColor">#33C6D5</Color>
    <Color x:Key="BandAverageColor">#E89E1B</Color>
    <Color x:Key="BandPoorColor">#E64A5B</Color>
    <Color x:Key="BandNeutralColor">#8E9FA1</Color>
    <Color x:Key="WarningOrangeColor">#FF9F0A</Color>
    <Color x:Key="AddedPurpleColor">#BF5AF2</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
    <SolidColorBrush x:Key="BrandOnAccentBrush" Color="{StaticResource BrandOnAccentColor}" />
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandSecondaryColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="{StaticResource SettingsBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryFillBrush" Color="{StaticResource TertiaryFillColor}" />
    <SolidColorBrush x:Key="HoverFillBrush" Color="{StaticResource HoverFillColor}" />
    <SolidColorBrush x:Key="SelectedFillBrush" Color="{StaticResource SelectedFillColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <SolidColorBrush x:Key="LabelBrush" Color="{StaticResource LabelColor}" />
    <SolidColorBrush x:Key="SecondaryLabelBrush" Color="{StaticResource SecondaryLabelColor}" />
    <SolidColorBrush x:Key="TertiaryLabelBrush" Color="{StaticResource TertiaryLabelColor}" />

    <SolidColorBrush x:Key="BandExcellentBrush" Color="{StaticResource BandExcellentColor}" />
    <SolidColorBrush x:Key="BandGoodBrush" Color="{StaticResource BandGoodColor}" />
    <SolidColorBrush x:Key="BandAverageBrush" Color="{StaticResource BandAverageColor}" />
    <SolidColorBrush x:Key="BandPoorBrush" Color="{StaticResource BandPoorColor}" />
    <SolidColorBrush x:Key="BandNeutralBrush" Color="{StaticResource BandNeutralColor}" />
    <SolidColorBrush x:Key="WarningOrangeBrush" Color="{StaticResource WarningOrangeColor}" />
    <SolidColorBrush x:Key="AddedPurpleBrush" Color="{StaticResource AddedPurpleColor}" />

    <SolidColorBrush x:Key="BandExcellentSoftBrush" Color="#281E9F69" />
    <SolidColorBrush x:Key="BandGoodSoftBrush" Color="#2833C6D5" />
    <SolidColorBrush x:Key="BandAverageSoftBrush" Color="#28E89E1B" />
    <SolidColorBrush x:Key="BandPoorSoftBrush" Color="#28E64A5B" />
    <SolidColorBrush x:Key="BandNeutralSoftBrush" Color="#288E9FA1" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="#241AFFBE" />
    <SolidColorBrush x:Key="BrandSecondarySoftBrush" Color="#241FF98C" />
    <SolidColorBrush x:Key="WarningOrangeSoftBrush" Color="#28FF9F0A" />
    <SolidColorBrush x:Key="AddedPurpleSoftBrush" Color="#28BF5AF2" />
</ResourceDictionary>
