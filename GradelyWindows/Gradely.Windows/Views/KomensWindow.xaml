<Window x:Class="Gradely.Windows.Views.KomensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradey — Komens"
        Width="840" Height="580" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <DockPanel Grid.Row="0" Margin="20,14">
            <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[nav.messages]}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />

            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Background="{DynamicResource TertiaryFillBrush}" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding L10n[komens.received]}" GroupName="KomensBox" IsChecked="{Binding IsReceived}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                        <RadioButton Content="{Binding L10n[komens.noticeboard]}" GroupName="KomensBox" IsChecked="{Binding IsNoticeboard}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </Border>
                <Button Content="&#xE72C;" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="{Binding L10n[common.refresh]}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource HairlineBrush}" />

        <!-- Mail-style Split Pane -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Message List -->
            <Grid Grid.Column="0">
                <TextBlock Text="{Binding L10n[komens.empty]}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Messages.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

                <ListBox ItemsSource="{Binding Messages}"
                         SelectedItem="{Binding SelectedMessage}"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFillBrush}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Top" Margin="0,6,8,0"
                                         Visibility="{Binding IsRead, Converter={StaticResource InvertBoolToVis}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Heading}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SenderName}" Style="{StaticResource SecondaryTextStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource TertiaryLabelBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}" />

            <!-- Right Reader Pane -->
            <Grid Grid.Column="2">
                <TextBlock Text="{Binding L10n[komens.selectPrompt]}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelectedMessage, Converter={StaticResource InvertBoolToVis}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,20">
                        <TextBlock Text="{Binding SelectedMessage.Heading}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedMessageMeta}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" Margin="0,0,0,14" />

                        <Border Style="{StaticResource HairlineSeparatorStyle}" Margin="0,0,0,14" />

                        <TextBox Text="{Binding SelectedMessage.Body, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource LabelBrush}"
                                 FontFamily="{StaticResource GradelyFont}"
                                 FontSize="14" />

                        <!-- Attachments -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding SelectedMessage.Attachments.Count, Converter={StaticResource CountToVis}}">
                            <Border Style="{StaticResource HairlineSeparatorStyle}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding L10n[komens.attachments]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SelectedMessage.Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE723;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FormattedSize}" Style="{StaticResource SecondaryTextStyle}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="12.5" Margin="0,12,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
