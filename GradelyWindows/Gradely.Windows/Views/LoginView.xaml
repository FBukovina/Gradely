<UserControl x:Class="Gradely.Windows.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SettingsBackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="560" Margin="32,28,32,32" HorizontalAlignment="Center" Width="520">

                <!-- Header: Logo + Step Progress -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE72B;"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding BackToStep1Command}"
                                Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0" />
                        <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,10,0" />
                        <TextBlock Text="Gradey" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StepLabel}"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 5px Capsule Progress Bar -->
                <Grid Height="5" Margin="0,0,0,24">
                    <Border Background="{DynamicResource TertiaryFillBrush}" CornerRadius="3" />
                    <Border Background="{DynamicResource BrandGradientBrush}"
                            CornerRadius="3"
                            HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="260" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Width" Value="520" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>

                <!-- Hero Title -->
                <TextBlock Text="{Binding HeroTitle}" FontSize="34" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding HeroSubtitle}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontSize="14.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24" />

                <!-- STAGE 1: School Selection -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <!-- Provider Picker -->
                    <TextBlock Text="{Binding L10n[login.provider]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource TertiaryFillBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,18">
                        <UniformGrid Columns="2">
                            <RadioButton Content="Bakaláři"
                                         GroupName="ProviderGroup"
                                         IsChecked="{Binding IsBakalari}"
                                         Style="{StaticResource SegmentRadioButtonStyle}" />
                            <RadioButton Content="EduPage"
                                         GroupName="ProviderGroup"
                                         IsChecked="{Binding IsEduPage}"
                                         Style="{StaticResource SegmentRadioButtonStyle}" />
                        </UniformGrid>
                    </Border>

                    <!-- Bakalari School Directory Search -->
                    <StackPanel Visibility="{Binding IsBakalari, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                        <Grid>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BrandTextBoxStyle}"
                                     Padding="36,9,12,9"
                                     Tag="{Binding L10n[login.searchPlaceholder]}" />
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryLabelBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                            <TextBlock Text="{Binding L10n[login.searchPlaceholder]}"
                                       Foreground="{DynamicResource TertiaryLabelBrush}"
                                       FontSize="13.5"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="38,0,0,0"
                                       Visibility="{Binding HasSearchQuery, Converter={StaticResource InvertBoolToVis}}" />
                        </Grid>

                        <TextBlock Text="{Binding L10n[login.loadingDirectory]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="12"
                                   Margin="4,6,0,0"
                                   Visibility="{Binding IsLoadingDirectory, Converter={StaticResource BoolToVis}}" />

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,8,0,0"
                                MaxHeight="260"
                                Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSchoolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="12,10"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RowBg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DisplaySubtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource SecondaryLabelBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding L10n[login.noResults]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="12.5"
                                   Margin="4,8,0,0"
                                   Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Border Style="{StaticResource HairlineSeparatorStyle}" />

                    <!-- Manual School URL -->
                    <TextBlock Text="URL" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="SchoolUrlBox"
                                 Text="{Binding SchoolUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BrandTextBoxStyle}"
                                 KeyDown="SchoolUrlBox_KeyDown" />
                        <TextBlock Text="{Binding UrlPlaceholder}"
                                   Foreground="{DynamicResource TertiaryLabelBrush}"
                                   FontSize="13.5"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   Visibility="{Binding SchoolUrl, Converter={StaticResource InvertNullToVis}}" />
                    </Grid>

                    <!-- EduPage Hint -->
                    <TextBlock Text="{Binding L10n[login.edupageHint]}"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Visibility="{Binding IsEduPage, Converter={StaticResource BoolToVis}}" />

                    <!-- Collapsible Bakalari Help -->
                    <Expander Header="{Binding L10n[login.urlHelpTitle]}"
                              Foreground="{DynamicResource SecondaryLabelBrush}"
                              FontFamily="{StaticResource GradelyFont}"
                              FontSize="12.5"
                              Margin="0,0,0,16"
                              Visibility="{Binding IsBakalari, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding L10n[login.urlHelpBody]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="16,8,0,4" />
                    </Expander>

                    <!-- Error Banner -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource BandPoorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                    <!-- Continue CTA -->
                    <Button Content="{Binding L10n[login.continue]}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ContinueCommand}"
                            Margin="0,4,0,14" />

                    <!-- Demo Account & GitHub Links -->
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding UseDemoCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                Visibility="{Binding IsBakalari, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding L10n[login.demoButton]}" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                <TextBlock Text=" →" Foreground="{DynamicResource BrandPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Command="{Binding OpenGitHubCommand}"
                                Style="{StaticResource LinkButtonStyle}">
                            <TextBlock Text="{Binding L10n[login.githubLink]}" Foreground="{DynamicResource SecondaryLabelBrush}" FontWeight="Medium" FontSize="12.5" />
                        </Button>
                    </DockPanel>
                </StackPanel>

                <!-- STAGE 2: Credentials -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <!-- Selected School Summary -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSchoolName}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ProviderDisplayName, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SchoolUrl, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding L10n[common.change]}"
                                    Command="{Binding BackToStep1Command}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Username -->
                    <TextBlock Text="{Binding L10n[login.username]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BrandTextBoxStyle}"
                             Margin="0,0,0,14"
                             KeyDown="UsernameBox_KeyDown" />

                    <!-- Password -->
                    <TextBlock Text="{Binding L10n[login.password]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="PasswordBoxControl"
                                     Style="{StaticResource BrandPasswordBoxStyle}"
                                     Padding="12,8,40,8"
                                     PasswordChanged="PasswordBoxControl_PasswordChanged"
                                     KeyDown="PasswordBox_KeyDown"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource InvertBoolToVis}}" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BrandTextBoxStyle}"
                                 Padding="12,8,40,8"
                                 KeyDown="PasswordBox_KeyDown"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                        <ToggleButton IsChecked="{Binding ShowPassword}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Width="34" Height="34"
                                      Margin="0,0,4,0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SecondaryLabelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource BandPoorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                    <!-- Submit Button -->
                    <Button Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}">
                        <TextBlock Foreground="{DynamicResource BrandOnAccentBrush}" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding L10n[login.signIn]}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSubmitting}" Value="True">
                                            <Setter Property="Text" Value="{Binding L10n[login.signingIn]}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- EduPage 2FA Modal Overlay -->
        <Grid Background="#99000000" Visibility="{Binding IsShowingTwoFactor, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    MaxWidth="440"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Width="390">
                    <TextBlock Text="{Binding L10n[login.2fa.title]}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding L10n[login.2fa.subtitle]}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBox Text="{Binding TwoFactorCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource BrandTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource BrandPrimaryBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,10"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource BandPoorBrush}"
                               FontSize="12.5"
                               Margin="0,0,0,10"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

                    <Button Content="{Binding L10n[login.2fa.verify]}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SubmitTwoFactorCommand}"
                            Margin="0,0,0,10" />

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="{Binding L10n[login.2fa.checkApproval]}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding PollTwoFactorCommand}"
                                Margin="0,0,4,0" />
                        <Button Content="{Binding L10n[login.2fa.resend]}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding ResendTwoFactorCommand}"
                                Margin="4,0,0,0" />
                    </UniformGrid>

                    <Button Content="{Binding L10n[common.cancel]}"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding CancelOverlayCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- EduPage Parent Student Picker Overlay -->
        <Grid Background="#99000000" Visibility="{Binding IsShowingStudentPicker, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    MaxWidth="440"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Width="390">
                    <TextBlock Text="{Binding L10n[login.child.title]}" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding L10n[login.child.subtitle]}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding AvailableStudents}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding ClassName}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding L10n[common.cancel]}"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding CancelOverlayCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
