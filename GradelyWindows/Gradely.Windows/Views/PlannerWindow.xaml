<Window x:Class="Gradely.Windows.Views.PlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradey — Planner"
        Width="700" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="20,14">
            <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[nav.planner]}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Background="{DynamicResource TertiaryFillBrush}" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding L10n[planner.upcoming]}" GroupName="PlannerFilter" IsChecked="{Binding IsUpcomingTab}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                        <RadioButton Content="{Binding L10n[planner.completed]}" GroupName="PlannerFilter" IsChecked="{Binding IsCompletedTab}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </Border>
                <Button Content="{Binding L10n[planner.newItem]}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" MinHeight="30" FontSize="12.5" Command="{Binding NewItemCommand}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource HairlineBrush}" />

        <!-- Entries List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <TextBlock Text="{Binding L10n[today.noPlanner]}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding Entries.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="0,2,10,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1.8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryLabelBrush}" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrandOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TertiaryLabelBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding Notes, Converter={StaticResource NullToVis}}" />

                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0"
                                                      Visibility="{Binding Attachments.Count, Converter={StaticResource CountToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Name, StringFormat=📎 {0}}" FontSize="12" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                Visibility="{Binding IsSchoolHomework, Converter={StaticResource InvertBoolToVis}}">
                                        <Button Content="&#xE70F;" Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding DataContext.L10n[common.edit], RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource BandPoorBrush}"
                                                Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding DataContext.L10n[common.delete], RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor Modal Overlay -->
        <Grid Grid.RowSpan="3" Background="#99000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                    CornerRadius="16" Width="460" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EditorHeader}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding L10n[planner.type]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding PlannerTypes}" SelectedItem="{Binding EditorType}" Margin="0,0,0,12" Height="32" />

                    <TextBlock Text="{Binding L10n[planner.titlePlaceholder]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrandTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding L10n[planner.notesPlaceholder]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrandTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalContentAlignment="Top" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding L10n[planner.subject]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AvailableSubjects}" DisplayMemberPath="TrimmedName" SelectedValuePath="Id" SelectedValue="{Binding EditorSubjectId}" Height="32" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding L10n[planner.dueDate]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,5" />
                            <DatePicker SelectedDate="{Binding EditorDueDate}" Height="32" />
                        </StackPanel>
                    </Grid>

                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="{Binding L10n[common.cancel]}" Style="{StaticResource SubtleButtonStyle}" Command="{Binding CancelEditorCommand}" />
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{Binding L10n[common.save]}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveEditorCommand}" MinWidth="110" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
