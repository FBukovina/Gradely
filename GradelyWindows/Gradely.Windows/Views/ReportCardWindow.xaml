<Window x:Class="Gradely.Windows.Views.ReportCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gradey — Report Card"
        Width="760" Height="600" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="32,24,32,36">
            <TextBlock Text="{Binding L10n[nav.reportCard]}" Style="{StaticResource DisplayTitleTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CurrentTermTitle}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding EstimatedAverageText}"
                       Style="{StaticResource HeroNumberTextStyle}"
                       Foreground="{Binding EstimatedAverageBand, Converter={StaticResource GradeBandBrush}}"
                       Margin="0,2,0,10" />

            <Border Style="{StaticResource HairlineSeparatorStyle}" />

            <!-- Current Term Estimate -->
            <TextBlock Text="{Binding L10n[reportCard.currentEstimate]}" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding CurrentEstimates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SubjectName}" FontSize="14.5" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" />
                                        <TextBlock Text="{Binding BorderlineWarning}" Foreground="{DynamicResource WarningOrangeBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   Visibility="{Binding BorderlineWarning, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" MinWidth="42" Height="36" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{Binding Band, Converter={StaticResource GradeBandSoftBrush}}">
                                    <TextBlock Text="{Binding DisplayMark}" FontSize="18" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                                               Foreground="{Binding Band, Converter={StaticResource GradeBandBrush}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Past Report Cards -->
            <StackPanel Visibility="{Binding PastTerms.Count, Converter={StaticResource CountToVis}}" Margin="0,18,0,0">
                <Border Style="{StaticResource HairlineSeparatorStyle}" />
                <TextBlock Text="{Binding L10n[reportCard.pastTerms]}" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding PastTerms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock FontSize="15.5" FontWeight="Bold">
                                                <Run Text="{Binding SchoolYear, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Semester, StringFormat={}{0}. pololetí, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding AchievementText}" Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"
                                                       Visibility="{Binding AchievementText, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   Text="{Binding Average, StringFormat={}{0:F2}}"
                                                   FontSize="20" FontWeight="Bold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Marks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding SubjectName}" FontSize="13.5" />
                                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding MarkText}" FontSize="13.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
