<UserControl x:Class="Gradely.Windows.Views.StravaCZView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <!-- SIGNED OUT: Strava.cz Connect Form -->
            <StackPanel MaxWidth="520" Margin="32,40" HorizontalAlignment="Center" Width="480"
                        Visibility="{Binding Strava.IsConnected, Converter={StaticResource InvertBoolToVis}}">
                <TextBlock Text="{Binding L10n[meals.connectTitle]}" Style="{StaticResource DisplayTitleTextStyle}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding L10n[meals.connectSubtitle]}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,22" />

                <TextBlock Text="{Binding L10n[meals.canteenNumber]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Strava.CanteenNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrandTextBoxStyle}" Margin="0,0,0,14" />

                <TextBlock Text="{Binding L10n[login.username]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Strava.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BrandTextBoxStyle}" Margin="0,0,0,14" />

                <TextBlock Text="{Binding L10n[login.password]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                <PasswordBox x:Name="StravaPasswordBox" Style="{StaticResource BrandPasswordBoxStyle}" PasswordChanged="StravaPasswordBox_PasswordChanged" Margin="0,0,0,16" />

                <TextBlock Text="{Binding Strava.ErrorMessage}" Foreground="{DynamicResource BandPoorBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding Strava.ErrorMessage, Converter={StaticResource NullToVis}}" />

                <Button Content="{Binding L10n[meals.connect]}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Strava.ConnectCommand}" Margin="0,0,0,12" />
                <Button Content="{Binding L10n[login.demoButton]}" Style="{StaticResource LinkButtonStyle}" Command="{Binding Strava.ConnectDemoCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- SIGNED IN: Balance Hero + Daily Menus -->
            <StackPanel MaxWidth="760" Margin="32,24,32,40"
                        Visibility="{Binding Strava.IsConnected, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding L10n[meals.balance]}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Strava.BalanceText}" FontSize="42" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Content="{Binding L10n[meals.disconnect]}" Style="{StaticResource SubtleButtonStyle}" Command="{Binding Strava.DisconnectCommand}" />
                </DockPanel>

                <!-- 2 StatTiles: Ordered & Canteen -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding L10n[meals.ordered]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                        <TextBlock Text="{Binding Strava.OrderedCount}" FontSize="20" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="1" Height="32" Background="{DynamicResource HairlineBrush}" Margin="16,0" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding L10n[meals.canteen]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                        <TextBlock Text="{Binding Strava.CanteenLabel}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Strava.ErrorMessage}" Foreground="{DynamicResource BandPoorBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding Strava.ErrorMessage, Converter={StaticResource NullToVis}}" />

                <Border Style="{StaticResource HairlineSeparatorStyle}" />

                <TextBlock Text="{Binding L10n[meals.empty]}" Style="{StaticResource SecondaryTextStyle}"
                           Visibility="{Binding Strava.Days.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

                <ItemsControl ItemsSource="{Binding Strava.Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,22">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding WeekdayTitle}" Style="{StaticResource SectionTitleTextStyle}" />
                                    <TextBlock Text="{Binding ShortDate}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Bottom" Margin="10,0,0,2" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Meals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Margin="0,0,14,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border CornerRadius="6" Padding="7,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource TertiaryFillBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding TypeBadge}" FontSize="10.5" FontWeight="Bold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock Text="{Binding PriceText}" Style="{StaticResource SecondaryTextStyle}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding PriceText, Converter={StaticResource NullToVis}}" />
                                                            <TextBlock Text="{Binding AllergensText, StringFormat=A: {0}}" Style="{StaticResource SecondaryTextStyle}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding AllergensText, Converter={StaticResource NullToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="Medium" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Desktop 22x22 Order Checkbox -->
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.Strava.ToggleMealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding CanModify}"
                                                            Visibility="{Binding IsMain, Converter={StaticResource BoolToVis}}"
                                                            Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Width="22" Height="22" CornerRadius="6" BorderThickness="1.8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryLabelBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOrdered}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrandOnAccentBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsOrdered, Converter={StaticResource BoolToVis}}" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
