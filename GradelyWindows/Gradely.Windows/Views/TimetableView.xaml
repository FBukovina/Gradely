<UserControl x:Class="Gradely.Windows.Views.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Reusable template for a day cell containing 0..N lessons -->
        <DataTemplate x:Key="DayCellTemplate">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.Timetable.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                Padding="6,6" Margin="2" Cursor="Hand"
                                ToolTip="{Binding Lesson.SubjectName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CellRoot" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentNow}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CellRoot" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="2" Margin="0,1,0,1"
                                        Background="{Binding Lesson.ChangeKind, Converter={StaticResource LessonChangeBrush}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Lesson.IsCanceled}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding Lesson.SubjectName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentNow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Lesson.IsCanceled}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="{Binding ChangeLabel}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{Binding Lesson.ChangeKind, Converter={StaticResource LessonChangeBrush}}"
                                               Visibility="{Binding ChangeLabel, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="● Planner" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}"
                                               Visibility="{Binding HasPlannerItem, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- MAIN TIMETABLE GRID -->
        <Grid Grid.Column="0" Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Controls: Week Switcher & Actual/Permanent Toggle -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE76B;" Style="{StaticResource IconButtonStyle}" Command="{Binding Timetable.PreviousWeekCommand}"
                            Visibility="{Binding Timetable.IsActual, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Timetable.WeekTitle}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" />
                    <Button Content="&#xE76C;" Style="{StaticResource IconButtonStyle}" Command="{Binding Timetable.NextWeekCommand}"
                            Visibility="{Binding Timetable.IsActual, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding L10n[common.today]}" Style="{StaticResource SubtleButtonStyle}" Command="{Binding Timetable.TodayWeekCommand}" Margin="10,0,0,0"
                            Visibility="{Binding Timetable.IsCurrentWeek, Converter={StaticResource InvertBoolToVis}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border Background="{DynamicResource TertiaryFillBrush}" CornerRadius="8" Padding="3" Margin="0,0,10,0"
                            Visibility="{Binding Timetable.SupportsPermanent, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding L10n[timetable.actual]}" GroupName="TtKind" IsChecked="{Binding Timetable.IsActual}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                            <RadioButton Content="{Binding L10n[timetable.permanent]}" GroupName="TtKind" IsChecked="{Binding Timetable.IsPermanent}" Style="{StaticResource SegmentRadioButtonStyle}" Padding="10,4" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding L10n[nav.planner]}" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenPlannerCommand}" />
                </StackPanel>
            </DockPanel>

            <!-- Permanent Timetable Banner / Error -->
            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding Timetable.IsPermanent, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding L10n[timetable.permanentBanner]}" Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" />
                </Border>

                <!-- 5-Day Column Headers -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Timetable.DayHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding WeekdayShort}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                               Visibility="{Binding DayNumber, Converter={StaticResource NullToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding HolidayDescription}" FontSize="10.5" Foreground="{DynamicResource WarningOrangeBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HolidayDescription, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>

            <!-- Scrollable Period Rows -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Timetable.GridRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,5">
                                <Grid MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Period Rail -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Hour.Caption}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentHour}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Hour.BeginTime}" FontSize="10.5" Foreground="{DynamicResource TertiaryLabelBrush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="{Binding Hour.EndTime}" FontSize="10.5" Foreground="{DynamicResource TertiaryLabelBrush}" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>

                                    <ContentPresenter Grid.Column="1" Content="{Binding Monday}" ContentTemplate="{StaticResource DayCellTemplate}" />
                                    <ContentPresenter Grid.Column="2" Content="{Binding Tuesday}" ContentTemplate="{StaticResource DayCellTemplate}" />
                                    <ContentPresenter Grid.Column="3" Content="{Binding Wednesday}" ContentTemplate="{StaticResource DayCellTemplate}" />
                                    <ContentPresenter Grid.Column="4" Content="{Binding Thursday}" ContentTemplate="{StaticResource DayCellTemplate}" />
                                    <ContentPresenter Grid.Column="5" Content="{Binding Friday}" ContentTemplate="{StaticResource DayCellTemplate}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- LESSON DETAIL SIDE PANEL -->
        <Border Grid.Column="1" Width="330"
                Background="{DynamicResource SettingsBackgroundBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding Timetable.HasSelectedLesson, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Timetable.SelectedLesson.Lesson.SubjectName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="245" />
                        <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" Command="{Binding Timetable.CloseDetailCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </DockPanel>

                    <!-- Change Alert Card -->
                    <Border CornerRadius="12" Padding="12" Margin="0,0,0,14"
                            Background="{DynamicResource BandAverageSoftBrush}"
                            Visibility="{Binding Timetable.SelectedLesson.Lesson.HasChange, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Timetable.SelectedLesson.ChangeLabel}" FontWeight="Bold" FontSize="13"
                                       Foreground="{Binding Timetable.SelectedLesson.Lesson.ChangeKind, Converter={StaticResource LessonChangeBrush}}" />
                            <TextBlock Text="{Binding Timetable.SelectedLesson.Lesson.Change.Description}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding Timetable.SelectedLesson.Lesson.Change.Description, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Details List -->
                    <StackPanel>
                        <TextBlock Text="{Binding L10n[timetable.time]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                        <TextBlock Text="{Binding Timetable.SelectedLessonTimeText}" FontSize="14" FontWeight="Medium" Margin="0,2,0,12" />

                        <StackPanel Visibility="{Binding Timetable.SelectedLesson.Lesson.TeacherName, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n[timetable.teacher]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                            <TextBlock Text="{Binding Timetable.SelectedLesson.Lesson.TeacherName}" FontSize="14" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Timetable.SelectedLesson.Lesson.RoomName, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n[timetable.room]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                            <TextBlock Text="{Binding Timetable.SelectedLesson.Lesson.RoomName}" FontSize="14" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Timetable.SelectedLessonGroupsText, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n[timetable.groups]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                            <TextBlock Text="{Binding Timetable.SelectedLessonGroupsText}" FontSize="14" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Timetable.SelectedLessonCyclesText, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n[timetable.cycles]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                            <TextBlock Text="{Binding Timetable.SelectedLessonCyclesText}" FontSize="14" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding Timetable.SelectedLesson.Lesson.Theme, Converter={StaticResource NullToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="{Binding L10n[timetable.theme]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                            <TextBlock Text="{Binding Timetable.SelectedLesson.Lesson.Theme}" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Linked Homeworks -->
                    <StackPanel Visibility="{Binding Timetable.SelectedLessonHomeworks.Count, Converter={StaticResource CountToVis}}" Margin="0,4,0,12">
                        <Border Style="{StaticResource HairlineSeparatorStyle}" />
                        <TextBlock Text="{Binding L10n[planner.schoolHomework]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Timetable.SelectedLessonHomeworks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Linked Planner Items -->
                    <StackPanel Visibility="{Binding Timetable.SelectedLessonPlannerItems.Count, Converter={StaticResource CountToVis}}" Margin="0,0,0,12">
                        <Border Style="{StaticResource HairlineSeparatorStyle}" />
                        <TextBlock Text="{Binding L10n[nav.planner]}" Style="{StaticResource SectionHeaderCapsStyle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Timetable.SelectedLessonPlannerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrandPrimarySoftBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrandPrimaryBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Content="{Binding L10n[timetable.addToPlanner]}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding Timetable.AddSelectedLessonToPlannerCommand}"
                            Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
