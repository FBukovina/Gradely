<UserControl x:Class="Gradely.Windows.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="32,24,32,40">

            <!-- Hero Greeting -->
            <TextBlock Text="{Binding Today.Greeting}" Style="{StaticResource DisplayTitleTextStyle}" Margin="0,0,0,18" />

            <!-- 3 KPI StatTiles separated by vertical hairlines -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding L10n[today.kpi.average]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                    <TextBlock Text="{Binding Today.OverallAverageText}"
                               FontSize="26"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{Binding Today.OverallAverageBand, Converter={StaticResource GradeBandBrush}}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="36" Background="{DynamicResource HairlineBrush}" Margin="16,0" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding L10n[today.kpi.lessons]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                    <TextBlock Text="{Binding Today.LessonsTodayCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="3" Width="1" Height="36" Background="{DynamicResource HairlineBrush}" Margin="16,0" />

                <StackPanel Grid.Column="4">
                    <TextBlock Text="{Binding L10n[today.kpi.newMarks]}" Style="{StaticResource SectionHeaderCapsStyle}" />
                    <TextBlock Text="{Binding Today.NewMarksCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource BrandPrimaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HairlineSeparatorStyle}" />

            <!-- NOW & NEXT SECTION -->
            <DockPanel Margin="0,4,0,12">
                <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[today.nowAndNext]}" Style="{StaticResource SectionTitleTextStyle}" />
                <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="{Binding L10n[nav.timetable]}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Timetable"
                        Style="{StaticResource LinkButtonStyle}" />
            </DockPanel>

            <!-- Horizontal Lesson Strip -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14"
                          Visibility="{Binding Today.LessonStrip.Count, Converter={StaticResource CountToVis}}">
                <ItemsControl ItemsSource="{Binding Today.LessonStrip}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="56" CornerRadius="10" Padding="10,7" Margin="0,0,8,0" ToolTip="{Binding SubjectName}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource TertiaryFillBrush}" />
                                                <Setter Property="Opacity" Value="0.6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BandPoorSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="6" Height="6"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-2,-2,0"
                                             Fill="{Binding ChangeKind, Converter={StaticResource LessonChangeBrush}}"
                                             Visibility="{Binding HasNonCancelChange, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PeriodCaption}" FontSize="11" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandOnAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SubjectAbbrev}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandOnAccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BandPoorBrush}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Current Lesson Row -->
            <Border Background="{DynamicResource BrandPrimarySoftBrush}"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,10"
                    Visibility="{Binding Today.HasCurrentLesson, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrandGradientBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Today.CurrentPeriod}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrandOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Today.CurrentStatusLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                        <TextBlock Text="{Binding Today.CurrentSubject}" FontSize="17" FontWeight="Bold" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Today.CurrentMeta}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                        <ProgressBar Value="{Binding Today.CurrentProgress}" Minimum="0" Maximum="1" Height="5" Margin="0,10,0,0"
                                     Foreground="{DynamicResource BrandPrimaryBrush}" Background="{DynamicResource TertiaryFillBrush}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Next Lesson Row -->
            <Border Background="{DynamicResource BrandSecondarySoftBrush}"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,0,0,10"
                    Visibility="{Binding Today.HasNextLesson, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrandSecondarySoftBrush}" BorderBrush="{DynamicResource BrandSecondaryBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Today.NextPeriod}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrandSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Today.NextStatusLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrandSecondaryBrush}" />
                        <TextBlock Text="{Binding Today.NextSubject}" FontSize="16" FontWeight="Bold" Margin="0,2,0,2" />
                        <TextBlock Text="{Binding Today.NextMeta}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty / After School State -->
            <TextBlock Text="{Binding Today.ScheduleEmptyMessage}"
                       Style="{StaticResource SecondaryTextStyle}"
                       FontSize="14"
                       Margin="0,4,0,8"
                       Visibility="{Binding Today.ScheduleEmptyMessage, Converter={StaticResource NullToVis}}" />

            <!-- Today's Timetable Changes -->
            <StackPanel Margin="0,6,0,4" Visibility="{Binding Today.Changes.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="{Binding L10n[today.changes]}" Style="{StaticResource SectionHeaderCapsStyle}" Foreground="{DynamicResource BandPoorBrush}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Today.Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding ChangeKind, Converter={StaticResource LessonChangeBrush}}" CornerRadius="2" Margin="0,2,0,2" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold">
                                        <Run Text="{Binding SubjectName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding ChangeLabel, Mode=OneWay}" Foreground="{Binding ChangeKind, Converter={StaticResource LessonChangeBrush}}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12">
                                        <Run Text="{Binding PeriodAndTime, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Style="{StaticResource HairlineSeparatorStyle}" />

            <!-- RECENT MARKS -->
            <DockPanel Margin="0,4,0,10">
                <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[today.recentMarks]}" Style="{StaticResource SectionTitleTextStyle}" />
                <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="{Binding L10n[nav.marks]}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="Marks"
                        Style="{StaticResource LinkButtonStyle}" />
            </DockPanel>

            <TextBlock Text="{Binding L10n[today.noRecentMarks]}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{Binding Today.RecentMarks.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{Binding Today.RecentMarks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenSubjectFromTodayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding SubjectId}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                Padding="6,8"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border MinWidth="44" Height="36" CornerRadius="10" Margin="0,0,12,0"
                                        Background="{Binding Band, Converter={StaticResource GradeBandSoftBrush}}">
                                    <TextBlock Text="{Binding MarkDisplay}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{Binding Band, Converter={StaticResource GradeBandBrush}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SubjectName}" FontSize="14.5" FontWeight="SemiBold" />
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandPrimaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding DateLabel}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource HairlineSeparatorStyle}" />

            <!-- PLANNER & HOMEWORK -->
            <DockPanel Margin="0,4,0,10">
                <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[today.planner]}" Style="{StaticResource SectionTitleTextStyle}" />
                <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Content="{Binding L10n[today.viewAll]}"
                        Command="{Binding OpenPlannerCommand}"
                        Style="{StaticResource LinkButtonStyle}" />
            </DockPanel>

            <TextBlock Text="{Binding L10n[today.noPlanner]}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Visibility="{Binding Today.UpcomingPlanner.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />

            <ItemsControl ItemsSource="{Binding Today.UpcomingPlanner}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenPlannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="6,7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverFillBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BrandPrimarySoftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssessment}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BandAverageSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MonthShort}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}" />
                                        <TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- TODAY'S LUNCH (conditional) -->
            <StackPanel Visibility="{Binding Today.ShowLunchSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource HairlineSeparatorStyle}" />
                <DockPanel Margin="0,4,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding L10n[today.lunch]}" Style="{StaticResource SectionTitleTextStyle}" />
                    <Button DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="{Binding L10n[nav.meals]}"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="Meals"
                            Style="{StaticResource LinkButtonStyle}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Today.TodayLunchTitle}" FontSize="14.5" FontWeight="Medium" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Today.TodayLunchPrice}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" Margin="12,0,0,0" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
