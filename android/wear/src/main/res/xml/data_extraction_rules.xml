<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The phone payload can contain account metadata and must never leave the paired watch. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
