# Gradey for Web — Environment Configuration
# Copy to web/.env for local development. Never commit real secrets.

# At least 32 random characters; encrypts dedicated web provider tokens at rest.
# When using Supabase PostgreSQL storage, use the same PROVIDER_SECRET_KEY configured in Supabase secrets.
PROVIDER_SECRET_KEY=replace_with_at_least_32_random_characters_secret

# Optional separate HMAC secret for CSRF tokens (defaults to PROVIDER_SECRET_KEY if omitted).
GRADEY_WEB_CSRF_SECRET=replace_with_at_least_32_random_characters_csrf_secret

# Gradey 2 Supabase project used to verify mobile Gradey ID sessions and (when SERVICE_ROLE_KEY is provided)
# persist web_pairing_challenges + web_sessions in PostgreSQL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser Origin(s), comma-separated (e.g. https://web.gradey.app)
GRADEY_WEB_ALLOWED_ORIGINS=http://localhost:5173

# Server port (defaults to 8787)
PORT=8787
