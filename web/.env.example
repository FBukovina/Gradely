# Gradey for Web — Environment Configuration
# Copy to web/.env for local development. Never commit real secrets.

# Recommended: shared 256-bit secret authenticating this BFF to the `web-bff-gateway`
# Supabase Edge Function so PROVIDER_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY never leave Supabase.
WEB_BFF_GATEWAY_SECRET=replace_with_at_least_32_random_characters_gateway_secret

# Optional separate HMAC secret for CSRF tokens (defaults to WEB_BFF_GATEWAY_SECRET if omitted).
GRADEY_WEB_CSRF_SECRET=replace_with_at_least_32_random_characters_csrf_secret

# Gradey 2 Supabase project URL & publishable key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Optional alternative modes (leave blank when using WEB_BFF_GATEWAY_SECRET):
SUPABASE_SERVICE_ROLE_KEY=
PROVIDER_SECRET_KEY=

# Allowed browser Origin(s), comma-separated (e.g. https://web.gradey.app)
GRADEY_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787

# Server port (defaults to 8787)
PORT=8787
